@model MTAoarsGeneral.ViewModels.Operations.AgencyDisplayViewModel
@using MTAoarsGeneral.Utilities.Mvc
<div id="agencyAccordion">
    @Html.PartialFor(model => model, "~/Views/Agency/Index.cshtml")
    <br />
    @Html.PartialFor(model => model.AgencyPrincipals, "~/Views/Agency/Principal.cshtml")
    <br />
    @Html.PartialFor(model => model.Nominee, "~/Views/Agency/Nominee.cshtml")
    <br />
    @Html.PartialFor(model => model.Address, "~/Views/Agency/Address.cshtml")
    <br />
    @if (Model.Spouse != null) {
        @Html.PartialFor(model => model.Spouse, "~/Views/Agency/Spouse.cshtml")
        <br />
    }
     @Html.PartialFor(model => model.Partners, "~/Views/Agency/Partner.cshtml")
     <br />
     @Html.PartialFor(model => model.Directors, "~/Views/Agency/Director.cshtml")
     <br />
      @Html.PartialFor(model => model.Shareholders, "~/Views/Agency/Shareholder.cshtml")
      @if (Model.Guarantor != null) {
           <br />
          @Html.PartialFor(model => model.Guarantor, "~/Views/Agency/Guarantor.cshtml")
      }
      
</div>
@Html.StyleSheet("~/Content/css/ui/ui.accordion.css")
@Html.Script("~/Scripts/ui/ui.accordion.js")
<script type="text/javascript">
    $(document).ready(function () {
        //  $("#agencyAccordion").accordion();
    });
</script>
