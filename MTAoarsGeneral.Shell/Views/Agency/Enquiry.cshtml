@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Operations.EnquiryViewModel
@section  PageTitle{
Enquiry
}
@section Breadcrumb {
    <a href="@Url.Action("Index", "Home")" title="Home">Home</a> > Enquiry
}


<div id="searchForm">
    <div class="column-content-box">
        <div class="content-box
content-box-header ui-corner-all">
            <div class="ui-state-default ui-corner-top ui-box-header">
                <span class="ui-icon float-left ui-icon-notice"></span>Search Agency
            </div>
            <div class="content-box-wrapper">
                @using (Html.BeginForm("Enquiry", "Agency")) {
                    @Html.PartialFor(model => model.AgencySearch, "~/Views/Agency/Search.cshtml");
                }
            </div>
        </div>
    </div>
</div>


<div id="divProcess">

    <div id="searchResult" class="hastable">
        <table id="kendoGrid">
            <thead>
                <tr>
                    <th>
                        Agency Number
                    </th>
                    <th>
                        Nominee Name
                    </th>
                    <th>
                        New IC
                    </th>
                    <th>
                        CompanyName
                    </th>
                    
                    <th>
                        Select
                    </th>
                </tr>
            </thead>
            <tbody data-bind="template:{name:'agent-template', foreach:agents}">
            </tbody>
        </table>
        <script type="text/html" id="agent-template">
		<tr>
			<td>
				<span data-bind="text:AgencyNumber" ></span>
			</td>
           
			<td><span data-bind="text:NomineeName" ></span></td>
			<td><span data-bind="text:NomineeNewICNumber"></span></td>
            <td><span data-bind="text:CompanyName"></span></td>
           
            <td>
             <a class="k-button" data-bind="event:{click:$parent.selectAgent}"><span class="k-icon k-i-close"></span></a>
            </td>
		</tr>
        </script>
        
      
    </div>

    <div id="agencyDetail">
        <div style="text-align:right"><a id="back">Back</a></div>
        <div id="agencyDetailContent"></div>
    </div>
</div>
<div id="exceptionDialog">
</div>
@section CssScript {
    <script type="text/javascript">

        $(function () {
             $("#agencyDetail").hide();
              $("#searchResult").hide();
            function AgencySearchViewModel() {
                var self = this;
                self.length = 0;
                self.agents = ko.observableArray([]);

                self.selectAgent = function () {
                    var id = this.AgencyID();
                    $("#searchResult").hide();
                    $("#searchForm").hide();
                    $("#agencyDetailContent").load("@Url.Action("Details")/" + id);
                    $("#agencyDetail").show();
                    
                }

                self.add = function (agent) {
                    var result = false;
                    ko.utils.arrayForEach(this.agents(), function (item) {
                        if (item.AgencyPrincipalID() == agent.AgencyPrincipalID()) result = true;
                    });

                    if (result == false) self.agents.push(agent);
                }
            }

            var agencySearchViewModel = new AgencySearchViewModel();
            ko.applyBindings(agencySearchViewModel, document.getElementById("searchResult"));

            $("#search", "#searchForm").click(function () {
                var data = $("form", "#searchForm").serialize();
                $.post('@Url.Action("AjaxList")',
                    data,
                    function (result) {
                        for (var i = 0; i < result.length; i++) {
                            agencySearchViewModel.add(ko.mapping.fromJS(result[i]));
                        }
                         $("#searchResult").show();
                          $("#agencyDetail").hide();
                    })
                    .error(function (data, textStatus, jqxhr) {
                        $("#exceptionDialog").html(data.responseText).dialog();
                    });
            });

            $("#submitForProcess").click(function () {
                $("form", "#divProcess").submit();
            });

            $("#back").click(function() {
               $("#searchResult").show();
                $("#searchForm").show();
               $("#agencyDetail").hide();
            });

        });
    </script>
}