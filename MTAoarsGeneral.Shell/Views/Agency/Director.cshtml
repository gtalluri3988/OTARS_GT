@model List<MTAoarsGeneral.ViewModels.Operations.MemberDisplayViewModel>
@if (Model.Count > 0) {
    <h4>
        <a href="#">Directors</a></h4>
    <div class="hastable">
        <table>
            <thead>
                <tr>
                    <th>
                        Name
                    </th>
                    <th>
                        New IC @@ Passport Num
                    </th>
                    <th>
                        Old IC / Passport
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var director in Model) {
                    <tr>
                        <td>@director.Name
                        </td>
                        <td>@GlobalHelper.Coalesce(director.NewICNumber, director.PassportNumber)
                        </td>
                        <td>@director.OldICNumber
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}