@using MTAoarsGeneral.Utilities.Mvc
@using MTAoarsGeneral.Utilities.Extensions;
@model MTAoarsGeneral.ViewModels.Operations.TerminationSearchViewModel
@section  PageTitle{
Termination
}
@section Breadcrumb {
    <a href="@Url.Action("Index", "Home")" title="Home">Home</a> > Termination
}
<div id="searchForm">
    <div class="column-content-box">
        <div class="content-box
content-box-header ui-corner-all">
            <div class="ui-state-default ui-corner-top ui-box-header">
                <span class="ui-icon float-left ui-icon-notice"></span>Search Agency
            </div>
            <div class="content-box-wrapper">
                @using (Html.BeginForm("Search", "Termination")) {
                  @*  @Html.PartialFor(model => model.AgencySearch, "~/Views/Agency/Search.cshtml");*@
                    <div class="hastable" id="search-agency">
                        <table>
                            <tr>
                                <td width="10%">Agency Number</td>
                                <td>
                                    @Html.TextBoxFor(model => model.AgencySearch.AgencyNumber, new { @class = "k-textbox small" })
                                    <span id="status-message" style="color:red"></span></td>
                                <td width="20%">
                                    <a href="#" id="search" class="btn ui-state-default ui-corner-all"><span class="ui-icon ui-icon-search"></span>Add To Terminate</a>
                                </td> 
                            </tr>
                        </table>
                     </div>
                    
                }
        </div>
    </div>
</div>

<div id="divProcess">
@using (Html.BeginForm("Process", "Termination")) {
    
    <div id="searchResult" class="hastable">
        <table id="kendoGrid">
            <thead>
                <tr>
                    <th>
                        Agency Number
                    </th>
                    <th>
                        Registration Type
                    </th>
                    <th>
                        Corporate Status
                    </th>
                    <th>
                        Nominee Name
                    </th>
                    <th>
                        New IC
                    </th>
                    <th>
                        Valid From
                    </th>
                    <th>
                        Valid To
                    </th>
                    <th>
                        Terminate On
                    </th>
                  @*  <th>
                        Remarks
                    </th>*@
                    <th>
                        Delete
                    </th>
                </tr>
            </thead>
            <tbody data-bind="template:{name:'agent-template', foreach:agents}">
            </tbody>
        </table>
        <script type="text/html" id="agent-template">
		<tr>
			<td>
				<span data-bind="text:AgencyNumber" ></span>
			</td>
            <td>
                <span data-bind="text:AgencyTypeDescription"></span>
            </td>
            <td>
               <span data-bind="text:IntermediaryTypeDescription"></span>
            </td>
			<td><span data-bind="text:NomineeName"></span></td>
			<td><span data-bind="text:NomineeNewICNumber"></span></td>
            <td><span data-bind="text:ValidFromLabel"></span></td>
            <td><span data-bind="text:ValidToLabel"></span></td>
            <td><input data-bind="datepicker:ScheduledOn"/></td>

            <td>
             <a class="k-button" data-bind="event:{click:$parent.deleteAgent}"><span class="k-icon k-i-close"></span></a>
            </td>
		</tr>
        </script>
        <input type="hidden" name="@ViewData.TemplateInfo.HtmlFieldPrefix.GetModelProperty("TerminationAgents")" data-bind="jsonHidden:agents" />
        <a href="#" id="submitForProcess" class="btn ui-state-default ui-corner-all"><span
                                            class="ui-icon ui-icon-grip-dotted-horizontal"></span>Submit </a>
    </div>
}
</div>
<div id="exceptionDialog">
</div>
@section CssScript {
    <script type="text/javascript">
         var terminationSearchViewModel;
        $(function () {
        $("#divProcess").hide();
            function TerminationSearchModel() {
                var self = this;
                self.length = 0;
                self.actions = ko.observableArray(@Html.Raw(@Json.Encode(Model.TerminationActions)));
                self.agents = ko.observableArray([]);

                self.deleteAgent = function () {
                    self.agents.remove(this);
                }

                self.add = function (agent) {
                    var result = false;
                    ko.utils.arrayForEach(this.agents(), function (item) {
                        if (item.AgencyPrincipalID() == agent.AgencyPrincipalID()) result = true;
                    });

                    if (result == false) self.agents.push(agent);
                }
            }

            terminationSearchViewModel = new TerminationSearchModel();
            ko.applyBindings(terminationSearchViewModel, document.getElementById("searchResult"));

            $("#search", "#searchForm").click(function() {
                searchAgency();
            });

            $("#submitForProcess").click(function() {
                $("form", "#divProcess").submit();
            });

             $("input[type='text']", "#search-agency").keypress(function(e) {
                if(e.keyCode == 13) {
                    searchAgency();
                    return false;
                }
             });

        });

        function searchAgency() {
            var data = $("form", "#searchForm").serialize();
            $.post('@Url.Action("AjaxList")',
                data,
                function (result) {
                    /*  for (var i = 0; i < result.length; i++) {
                        terminationSearchViewModel.add(ko.mapping.fromJS(result[i]));
                    }*/
                    if(result.Data != null) {
                        result.Data.Remarks = "Mutual";
                        result.Data.ActionID = 1;
                            terminationSearchViewModel.add(ko.mapping.fromJS(result.Data));
                            $("#divProcess").show();
                            $("input[type='text']", "#search-agency").val("");
                            $("input[type='text']", "#search-agency").focus();
                    }
                    $("#status-message").html(result.Status);

                })
                .error(function (data, textStatus, jqxhr) {
                    $("#exceptionDialog").html(data.responseText).dialog();
                });
        }
    </script>
}
