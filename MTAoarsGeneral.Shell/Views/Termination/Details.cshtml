@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Operations.TerminationDetailViewModel
@section  PageTitle{
Termination Confirmation
}
@section Breadcrumb {
   <a href="@Url.Action("Index", "Home")" title="Home">Home</a> > Termination
}
@section CssScript {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#submit").click(function () {
                submitData(function (data) {
                    onRegistrationSuccess(data, "");
                });
            });
        });
    </script>
}
<div id="exceptionDialog"></div>

<div id="mainContent">
    <div class="column-content-box">
        <div class="content-box
content-box-header ui-corner-all">
            <div class="ui-state-default ui-corner-top ui-box-header">
                <span class="ui-icon float-left ui-icon-notice"></span>Termination Confirmation
            </div>
            <div class="content-box-wrapper">
                <h2>
                    Confirm</h2>
                @{Html.RenderPartial("~/Views/Agency/Details.cshtml", Model.Agency);}
                <fieldset>
                    <ul>
                        <li>
                         @using (Html.BeginForm("Terminate", "Termination")) {
                            <div class="tab-button">
                                <a href="#" id="submit" class="btn ui-state-default ui-corner-all"><span class="ui-icon ui-icon-grip-dotted-horizontal">
                                </span>Submit </a>
                            </div>
                             @Html.Hidden("id", Model.AgencyPrincipalID)
                         }
                        </li>
                    </ul>
                </fieldset>
            </div>
        </div>
    </div>
</div>
