@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Operations.RegistrationConflictViewModel

@section Breadcrumb {
    <a href="#" title="Layout Options">Layout Options</a> > <a href="#" title="Two column layout">
        Two column layout</a> > This is a breadcrumb example
}
@section CssScript {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#submit").click(function () {
                submitData(function (data) {
                    onRegistrationSuccess(data, "individualRegistrationTabs");
                });
            });
        });
    </script>
}
@section  PageTitle{
Conflict Registration
}

<div id="mainContent">
    <div id="exceptionDialog"></div>
    <div class="column-content-box">
        <div class="content-box
content-box-header ui-corner-all">
            <div class="ui-state-default ui-corner-top ui-box-header">
                <span class="ui-icon float-left ui-icon-notice"></span>Conflict
            </div>
            <div class="content-box-wrapper">
                <h2>
                    This registration is under conflict and it will be processed subject to termination from other company.</h2>
                @{Html.RenderPartial("~/Views/Agency/Details.cshtml", Model.Agency);}
            </div>
        </div>
    </div>

    @using (Html.BeginForm("Conflict", "Registration")) {
        <div id="guarantor">
            <div class="column-content-box">
                <div class="content-box content-box-header ui-corner-all">
                    <div class="ui-state-default ui-corner-top ui-box-header">
                        <span class="ui-icon float-left ui-icon-notice"></span>Guarantor
                    </div>
                    <div class="content-box-wrapper">
                        <fieldset>
                            <ul>
                                <li>
                                    <label class="desc" for="Name">
                                      Select company where the user will be terminated</label>
                                      <div>
                                        @Html.RadioButtonListFor(model=>model.SourceCompanyID, Model.Principals)
                                      </div>
                                </li>
                            </ul>
                        </fieldset>
                        @Html.PartialFor(model => model.Guarantor, "GuarantorType")
                        <fieldset>
                            <ul>
                                <li>
                                    <div class="tab-button">
                                        <a href="#" id="submit" class="btn ui-state-default ui-corner-all"><span class="ui-icon ui-icon-grip-dotted-horizontal">
                                        </span>Submit </a>
                                    </div>
                                </li>
                            </ul>
                        </fieldset>
                    </div>
                </div>
            </div>
        </div>
        @Html.HiddenFor(model=>model.AgencyID)
        @Html.HiddenFor(model => model.IsGeneral)
    }
</div>
