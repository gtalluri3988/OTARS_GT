@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Operations.IndividualRegistrationViewModel
@section CssScript {
    @Html.StyleSheet("~/Content/css/ui/ui.datepicker.css")
    @Html.Script("~/Scripts/ui/ui.tabs.js")
    @Html.Script("~/Scripts/ui/ui.datepicker.js")
    @Html.Script("~/Scripts/tablesorter.js")
    @TabHelper.RegisterJavaScript("individualRegistrationTabs", Url.Action("IndividualCheck"), Url.Action("IndividualConfirm"), Url.Action("Individual"))
}
@section  PageTitle{
Individual Registration
}
@section Breadcrumb {
    <a href="@Url.Action("Index", "Home")" title="Home">Home</a> > Registration
}
<div id="mainContent">
    <div id="exceptionDialog">
    </div>
    
   
    <div id="individualRegistrationTabs">
        <ul>
            <li><a href="#nominee">Nominee</a></li>
            <li><a href="#address">Address</a></li>
            <li><a href="#qualification">Qualification</a></li>
            <li><a href="#spouse">Spouse</a></li>
            <li><a href="#guarantor">Guarantor</a></li>
        </ul>
        @using (Html.BeginForm("Individual", "Registration", new { id = "mainForm" })) {
            @Html.ValSummary()
            @TabHelper.DisplayPage("nominee", "Details for corporate nominee",
                    () => Html.PartialFor(model => model.CorporateNominee, "CorporateNominee"),
                    nextPage: "address")
            
            @TabHelper.DisplayPage("address", "Agency address",
                          () => Html.PartialFor(model => model.Address, "Address"),
                    previousPage: "nominee",
                    nextPage: "qualification")

            @TabHelper.DisplayPage("qualification", "Qualification",
                    () => Html.PartialFor(model => model.CorporateNominee.Qualification, "Qualification"),
                    previousPage: "address",
                        nextPage: "spouse")

            @TabHelper.DisplayPage("spouse", "Spouse",
                    () => Html.PartialFor(model => model.CorporateNominee.Spouse, "Spouse"),
                    previousPage: "qualification",
                        nextPage: "guarantor")

            @TabHelper.DisplayPage("guarantor", "Guarantor",
                        () => Html.PartialFor(model => model.Guarantor, "GuarantorType"),
                        previousPage: "spouse",
                    nextPage: "submit")

           
            @Html.HiddenFor(model => model.Agency.IsGeneral)
            @Html.HiddenFor(model => model.TypeID)
            @Html.HiddenFor(model => model.CompanyID)
    
        }
    </div>
    @TabHelper.DisplayConfirmationDivision()
</div>
