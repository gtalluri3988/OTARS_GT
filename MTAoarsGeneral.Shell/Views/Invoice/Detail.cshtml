@model IEnumerable<MTAoarsGeneral.ViewModels.Operations.InvoiceDetailViewModel>
@{
    ViewBag.Title = "Details";
    Layout = "";
}
<div class="hastable" id="experienceContent" class="k-content">
<table >
    <thead>
        <tr>
            <th>
               Date
            </th>
            <th>
                Description
            </th>
            <th>
               Amount
            </th>
           
        </tr>
    </thead>
    <tbody>
        @{
            decimal total = 0;
        }
        @foreach (var item in Model) {
            total += item.Amount;
            <tr>
                <td>@item.JournalCreatedDate</td>
                <td>@item.Description</td>
                <td>@item.Amount</td>
            </tr>
        }
        <tr>
            <td></td>
            <td>Total</td>
            <td><b>@total</b></td>
        </tr>
    </tbody>
    </table>
</div>
