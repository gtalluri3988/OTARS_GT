@using MTAoarsGeneral.Utilities.Mvc
@using MTAoarsGeneral.Utilities.Extensions
@model MTAoarsGeneral.ViewModels.Operations.PartnershipRegistrationViewModel

@Html.ValidationMessageFor(model => model.Partners.Count)           
<div id="partners-grid">
</div>

<script type="text/javascript">


    $(function () {
        
        var schema = {
            model: {
                fields:{
                    Name:{type:"string"},
                    OldICNumber: {type:"string"},
                    ICNumber: {type:"string"},
                    ICType: {defaultValue:{ID:"", Code:"", Description:""}}
                }
            }
        };

        $("#partners-grid").kendoGrid({
            dataSource: {data:mainViewModel.Partners, schema:schema},
            editable:true,
            selectable:true,
            navigatable:true,
            sortable:true,
            columns:[
                {field:"Name", title:"Name"}, 
                {field:"ICType", title:"IC Type", template:"#=ICType.Description#", editor:icTypeEditor}, 
                {field:"ICNumber", title:"IC Number"}, 
                {field:"OldICNumber", title:"Old IC Number"},
                {command:["destroy"]}
            ],
            toolbar:["create"]
        });

    });

    function icTypeEditor(container, options) {
        $('<input data-value-field="ID" data-text-field="Description"  data-bind="value:' + options.field + '"/>')
        .appendTo(container)
        .kendoDropDownList({
            autoBind: true,
            dataTextField: "Description",
            dataValueField: "ID",
            dataSource: {
                transport: {
                    read:"@Url.Action("ICTypes", "Lookup")"
                }
            }
        });
    }

    function getLookupValue(id) {
        for (var i = 0; i < partnershipViewModel.ICTypes.length; i++) {
            if (partnershipViewModel.ICTypes[i].ID == id) return partnershipViewModel.ICTypes[i].Description;
        }
        return "";
    }
</script>
