@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Operations.RegistrationConflictViewModel

<script type="text/javascript">
    var mainViewModel = kendo.observable(
        @Html.Raw(@Json.Encode(Model))
    );
</script>

<div id="main-content">
     <h2>This registration is under conflict and it will be processed subject to termination from other company.</h2>
     @{Html.RenderPartial("~/Views/Agency/Details.cshtml", Model.Agency);}
     @Html.ValSummary()
     <table class="mta-panel">
        <caption>Termination Company</caption>
        <tr>
            <th>Select company where the user will be terminated</th>
            <td>
                 @Html.RadioButtonListFor(model=>model.SourceCompanyID, Model.Principals)
            </td>
        </tr>
        <tr>
             <th>@Html.LabelFor(model=>model.DateAppointed)</th>
            <td>@Html.EditorFor(model=>model.DateAppointed, "DateEditor")</td>
        <tr>
        <tr>
            <th colspan="2">Please upload Termination Letter and Agent Movement Form</th>
        </tr>
        <tr>
            <td colspan="2">
                <input type="file" id="conflictDocuments"  name="conflictDocuments" />
            </td>
        </tr>
        </tr>
     </table>

     @Html.PartialFor(model => model.Guarantor, "Guarantor")
     <div style="text-align:right;margin:30px">
         <button id="submit-button" class="k-button"><span class="k-icon k-i-tick"></span>Submit</button>
    </div>
 </div>

 <script type="text/javascript">

     $(function () {
         addBreadCrumb("Conflict", "javascript:showDiv('#create-main')", 3);

         kendo.bind($("#main-content"), mainViewModel);

         $("#submit-button", "#main-content").click(function () {
             jsonPost("#main-content", "@Url.Content("ConflictSubmit")", mainViewModel, function (response) {
                 viewPost("#main-content", response.RedirectUrl, response.Data, function (result) {
                     postPage("#create-complete", result);
                 });
             });
             return false;
         });

         $("#conflictDocuments").kendoUpload({
            async: {
                saveUrl:"UploadConflictDocuments",
                removeUrl:"RemoveConflictDocuments"
            }
         });

     });

 </script>
