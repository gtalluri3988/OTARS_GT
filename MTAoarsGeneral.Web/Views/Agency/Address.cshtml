@model MTAoarsGeneral.ViewModels.Operations.AddressDisplayViewModel
<table class="mta-panel four-columns-grid">
    <caption>Address</caption>
    <tr>
        <th>Address 1</th>
        <td>@Model.Address1
        </td>
        <th>Address 2</th>
        <td>@Model.Address2
        </td>
    </tr>
    <tr>
        <th>City</th>
        <td>@Model.City
        </td>
        <th>State</th>
        <td>@Html.DisplayFor(model => model.State)
        </td>
    </tr>
    <tr>
        <th>Postal Code</th>
        <td>@Model.PostalCode
        </td>
        <th>&nbsp;</th>
        <td>&nbsp;</td>
    </tr>
</table>
