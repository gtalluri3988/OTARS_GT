@model List<MTAoarsGeneral.ViewModels.Operations.MemberDisplayViewModel>
    @if (Model.Count > 0)
    {
        <div style="width: 100%">
            <h4>Shareholders</h4>
            <div class="confirm-shareholders-grid">
            </div>
        </div>

        <script type="text/javascript">

        $(function () {
            $(".confirm-shareholders-grid").kendoGrid({
                dataSource: {
                    data: @Html.Raw(@Json.Encode(Model))
                },
                columns: [
                    { field: "Name", title: "Name" },
                    { field: "NewICNumber", title: "New IC @@ Passport Number", template: "#=coalesce(NewICNumber, PassportNumber) || ''#" },
                    { field: "OldICNumber", title: "Old IC" },
                    { field: "NewBusinessRegistrationNumber", title: "New Business Reg. No." },
                    { field: "ShareAmount", title: "Share Amount" },
                    { field: "SharePercentage", title: "Share Percentage(%)" },
                ]
            });
        });

        </script>

        <br />
    }
