@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Reports.TerminationListReportViewModel

<table class="mta-panel" id="parameters-table">
  
    <tr>
        <th>From Date</th>
        <td>
         @Html.EditorFor(model => model.FromDate, "DateEditor")
          
        </td>
   
        <th>To Date</th>
        <td>
         @Html.EditorFor(model => model.ToDate, "DateEditor")         
        </td>
    </tr>
    <tr>
        <th>Status</th>
        <td>
            @Html.BindDropDownListFor(model => model.ActionID, Url.Action("TerminationActions", "Lookup"), required:true)
        </td>
        
        <th colspan="2">
            <button class="k-button" id="fetch-button"><span class="k-icon k-i-search"></span>Fetch</button>
        </th>
    </tr>
</table>
<div id="report-div"></div>
<iframe id="report" class="mta-report-frame"></iframe>

<script type="text/javascript">

    $(function () {
        addBreadCrumb("Termination List Report", "#", 2);

        var viewModel =  kendo.observable(@Html.Raw(@Json.Encode(Model)))
        kendo.bind($("#parameters-table"), viewModel);
        
        $("#fetch-button").click(function () {
          viewModel.ActionID = viewModel.ActionID;
           reportPost("#parameters-table", "@Url.Content("~/Rdls/Display.aspx?report=TerminationList")", viewModel, "#report");
        });

    });
</script>