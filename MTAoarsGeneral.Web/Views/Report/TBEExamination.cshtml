@using MTAoarsGeneral.Utilities.Mvc
@using MTAoarsGeneral.Utilities.Constants
@model MTAoarsGeneral.ViewModels.Reports.TBEExaminationViewModel

<table class="mta-panel" id="parameters-table">
    <caption>TBE Examination (Not Attached Any TO)</caption>
    <tr>
        <th>IC No# / Name</th>
        <td colspan="2">
            @Html.BindTextBoxFor(model => model.Search)
        </td>
        <td colspan="2"></td>
    </tr>
    <tr>
        <th>From Date</th>
        <td>
            @Html.EditorFor(model => model.FromDate, "DateEditor")
        </td>

        <th>To Date</th>
        <td>
            @Html.EditorFor(model => model.ToDate, "DateEditor")
        </td>
        <th>
            <button class="k-button" id="fetch-button"><span class="k-icon k-i-search"></span>Fetch</button>
        </th>
    </tr>
</table>
<div id="report-div"></div>
<iframe id="report" class="mta-report-frame"></iframe>

<script type="text/javascript">

    $(function () {
        addBreadCrumb("TBE Examination", "#", 2);

        var viewModel = kendo.observable(@Html.Raw(@Json.Encode(Model)));

        if ($('#FromDate').length)
            viewModel.FromDate = getDate2($('#FromDate').val());
        if ($('#ToDate').length)
            viewModel.ToDate = getDate2($('#ToDate').val());

        //viewModel.FromDate = getO3Date(viewModel.FromDate);
        //viewModel.ToDate = getO3Date(viewModel.ToDate);
        kendo.bind($("#parameters-table"), viewModel);

        $("#fetch-button").click(function () {
            if ($('#FromDate').length)
                viewModel.FromDate = getDate2($('#FromDate').val());
            if ($('#ToDate').length)
                viewModel.ToDate = getDate2($('#ToDate').val());

           reportPost("#parameters-table", "@Url.Content(String.Format("~/Rdls/Display.aspx?report={0}", LookupConstants.Reports.TBEExamination))", viewModel, "#report");
        });
    });
</script>