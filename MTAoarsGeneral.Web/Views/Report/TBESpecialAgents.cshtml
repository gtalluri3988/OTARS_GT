@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Reports.TBESpecialAgentsReportViewModel

<table class="mta-panel" id="parameters-table">
    <tr>
        <th>Company</th>
        <td>
            @Html.BindTextBoxFor(model => model.Company)
        </td>
        <th>New IC Number</th>
        <td>
            @Html.BindTextBoxFor(model => model.ICNumber)
        </td>
    </tr>
    <tr>
        <th colspan="4">
            <button class="k-button" id="fetch-button"><span class="k-icon k-i-search"></span>Fetch</button>
        </th>
    </tr>
</table>
<div id="report-div"></div>
<iframe id="report" class="mta-report-frame"></iframe>

<script type="text/javascript">

    $(function () {
        addBreadCrumb("TBE Special Agents Report", "#", 2);
        var viewModel =  kendo.observable(@Html.Raw(@Json.Encode(Model))) ;
        kendo.bind($("#parameters-table"), viewModel);
        
        $("#fetch-button").click(function () {  
           reportPost("#parameters-table", "@Url.Content("~/Rdls/Display.aspx?report=TBESpecialAgents")", viewModel, "#report");
        });

    });
</script>