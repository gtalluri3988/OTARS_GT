@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Reports.ResignedActiveAgentsReportViewModel

<table class="mta-panel" id="parameters-table">
    <caption>Invoice Report Parameters</caption>
    <tr>
        <th>Year</th>
        <td>
            @Html.BindDropDownListFor(model => model.Year, Url.Action("Recent6Years", "Lookup"), required: true)
        </td>

        <th>Termination/Resign Month</th>
        <td>
            @Html.BindDropDownListFor(model => model.Month, Url.Action("AllMonths", "Lookup"), required: true)
        </td>

        <th>
            <button class="k-button" id="fetch-button"><span class="k-icon k-i-search"></span>Fetch</button>
        </th>
    </tr>
</table>
<div id="report-div"></div>
<iframe id="report" class="mta-report-frame"></iframe>

<script type="text/javascript">

    $(function () {
        addBreadCrumb("Resigned Active Agents", "#", 2);

        var viewModel =  kendo.observable(@Html.Raw(@Json.Encode(Model)))
        kendo.bind($("#parameters-table"), viewModel);

        $("#fetch-button").click(function () {
           reportPost("#parameters-table", "@Url.Content("~/Rdls/Display.aspx?report=ResignedActiveAgents")", viewModel, "#report");
        });

    });
</script>