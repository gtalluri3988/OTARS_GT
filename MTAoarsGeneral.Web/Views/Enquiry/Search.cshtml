</div>
<p class="text-center" style="font-size:0.8rem;">Information is updated as at @DateTime.Now.ToString("dd-MM-yyyy hh:mm:ss")</p>
<div id="result-content" style="display: none">
</div>
<script type="text/javascript">

    var searchViewModel = kendo.observable(
        @Html.Raw(@Json.Encode(Model))
    );

    $(function () {
        kendo.bind($("#enquiry-content"), searchViewModel);

        $("#submit-button").click(function() {
            jsonPost("#enquiry-content", "@Url.Action("SearchSubmit")", searchViewModel, function(response) {
               $("#enquiry-content").hide();
               $("#terms-condition").show();
            });
        });

        $("#agree-button").click(function() {
           /* jsonPost("#enquiry-content", "@Url.Action("Result")", searchViewModel, function(response) {
               $("#enquiry-content").hide();
               $("#terms-condition").hide();
               $("#result-content").html(response);
               $("#result-content").show();
            });*/
            $("#LookupCompany_ID").val(searchViewModel.Company.ID);
            $("#LookupCompany_Description").val(searchViewModel.Company.Description);
            $("form").submit();
        });

        $("#dont-agree-button").click(function() {
                $("#enquiry-content").show();
               $("#terms-condition").hide();
        });

    });
</script>
