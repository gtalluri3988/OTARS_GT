@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Enquiries.SearchViewModel
@{
    Layout = "~/Views/Shared/_EnquiryLayout.cshtml";
}
<style type="text/css">
    .k-tooltip-validation {
        color: #ff0000;
        font-weight: bold;    font-size: 0.8rem;
    }
    .k-tooltip {
        position:relative;
        list-style:none;
        z-index:1;
    }
    span.k-dropdown{width: 80%;}
    table.table caption 
    {
        caption-side:top;
        background-color: #0199cb;
        font-weight: bold;
        font-size: 1.1rem;
        text-align: left;
        padding-left: 6px;
        color: #fff;
    }
    .mta-panel td[scope="row"] {
        background-color: #e1e1e1!important;
    }
    .mta-error-summary{margin:5px 0; display:none;}
    label{margin-bottom:0;}
</style>
@section CssScript{
    <script type="text/javascript">
        $(function () {
            

             $("#captcha").click(function(){
                $(this).attr("src", "@Url.Action("../Account/CaptchaImage")?time=" + (new Date()).getTime());
                return false;
            });

            setInterval(function() {
                $("#captcha").attr("src", "@Url.Action("../Account/CaptchaImage")?time=" + (new Date()).getTime());
            }, 30000);

            $("input").keypress(function(e) {
                if(e.which == 13) {
                   //$("#submit-button").click();
                    e.preventDefault();
                    return false;
                }
            });

        });
        

    </script>
}
 <div id="info-window">
 </div>
 
<div id="enquiry-content" align="center">
    @using (Html.BeginForm("Result", "Enquiry", FormMethod.Post)) {
        <div style="width:50%;text-align:center">
            @Html.ValSummary()
        </div>
        <table class="table table-sm table-bordered mb-0 mta-panel" style="border-bottom: none;">
            <caption>Enquiry</caption>
            <tbody>
                <tr>
                    <td scope="row">
                        <label for="RegistrationNumber">
                            MTA Agency Number</label><br />
                        (e.g. MTA-Z99999)
                    </td>
                    <td>
                        @Html.BindTextBoxFor(model => model.RegistrationNumber)
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        OR
                    </td>
                </tr>
                <tr>
                    <td scope="row">
                        <label for="ICNumber">
                            NRIC / Passport Number</label><br />
                        (e.g. 999999999999 or X9999999)
                    </td>
                    <td>
                        @Html.BindTextBoxFor(model => model.ICNumber)
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        And
                    </td>
                </tr>
                <tr>
                    <td scope="row">@Html.LabelFor(model => model.Company)</td>
                    <td>@Html.BindDropDownListFor(model => model.Company, Url.Action("EnquiryCompanies", "Lookup"))
                    </td>
                </tr>
                <tr>
                    <td scope="row">
                        Enter the character as seen on the image :
                        <br />
                        (click the image to refresh)
                    </td>
                    <td>
                        @Html.BindTextBoxFor(model => model.CaptchaKey,0,false,true)
                        <br />
                        <input type="image" id="captcha" src="@Url.Action("../Account/CaptchaImage")" alt="click to refresh" />
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="text-align: right;border-bottom: none;">
                        <button id="submit-button" type="button" class="k-button">
                            <span class="k-icon k-i-tick"></span>Submit</button>
                    </td>
                </tr>
            </tbody>
        </table>
        @Html.Hidden("LookupCompany.ID")
        @Html.Hidden("LookupCompany.Description")
    }
</div>
