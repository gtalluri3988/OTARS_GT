@using MTAoarsGeneral.Utilities.Mvc
@using MTAoarsGeneral.Utilities.Extensions;
@model MTAoarsGeneral.ViewModels.Operations.TerminationSearchViewModel
<div id="main-content">
    @Html.ValidationSummary()
    <table class="mta-panel" id="search-content" style="align:center">
        <caption>Search Agency</caption>
        <tr>
            <th>Agency Number</th>
            <td>@Html.BindTextBoxFor(model => model.AgencySearch.AgencyNumber)</td>
            <td class="for-button"><button id="search-button" class="k-button"><span class="k-icon k-i-search"></span>Search</button></td>
        </tr>
        <tr>
            <td colspan="3">
                Or
            </td>
        </tr>

        <tr>
            @using (Html.BeginForm("Upload", "Termination", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <th>
                    Excel Upload
                </th>
                <td>
                    <input type="file" id="fileTermination" name="fileTermination" />
                </td>
                <td>
                    <button id="upload-button" class="k-button"><span class="k-icon k-i-search"></span>Upload</button>
                </td>

            }
        </tr>
    </table>
    <br />

    @Html.ValSummary()
    <div id="termination-agents"></div>
</div>

<div id='complete-content'>
    <div class="k-block k-success-colored">Agents have been submitted to process termination.</div>
</div>

<script type="text/javascript">
     var viewModel = kendo.observable(
            @Html.Raw(@Json.Encode(Model))
        );
    var terminationActions = @Html.Raw(Json.Encode(Model.TerminationActions));
    $(function () {
        $('#complete-content').hide();
        addBreadCrumb("Termination", "@Url.Action("Search", "Termination")", 1);
        kendo.bind($("#main-content"), viewModel);

        var schema = {
            id:"AgencyID",
            model: {
                fields: {
                    AgencyNumber:{editable:false}, AgencyTypeDescription: {editable:false}, IntermediaryTypeDescription:{editable:false},
                    NomineeName:{editable:false}, NomineeNewICNumber: {editable:false}, ValidFromLabel:{editable:false},
                    ValidToLabel: {editable:false},
                    ScheduledOn:{type:"date",
                        editable:true,
                        validation: {
                            required:false,
                            custom: function(input) {
                            if(input.val()=="" || input.val()==null)
                            return true;
                                input.attr("data-custom-msg", "Termination date cannot be greater than current date");
                                var today = new Date();
                                today = new Date(today.getFullYear(), today.getMonth(), today.getDate());
                                return getDate(input.val()) <= today;
                            }
                        }
                    },
                    TerminationStatus:{defaultValue:{ID:"1", Description:"Terminate"}, validation: { required: true}},
                    Remarks:{type:"string"}
                }
            }
        }

        function bindGrid() {
            $("#termination-agents").kendoGrid({
                dataSource:{
                    data:viewModel.TerminationAgents,
                    schema:schema
                },
                editable:true,
                filterable:true,
                navigatable:true,
                height:"250px",
                columns:[
                    {field:"AgencyNumber", title:"Agency Number", editable:false, width:"125px"},
                    {field:"AgencyTypeDescription", title:"Registration Type", width:"125px", filterable:false},
                    {field:"IntermediaryTypeDescription", title:"Corporate Status", width:"125px", filterable:false},
                    {field:"NomineeName", title:"Nominee Name", filterable:false},
                    {field:"NomineeNewICNumber", title:"New IC", width:"100px", filterable:false}, {field:"ValidFromLabel", title:"Valid From", width:"100px", filterable:false},
                    {field:"ValidToLabel", title:"Valid To", width:"100px", filterable:false},{field:"ScheduledOn", title:"Date Terminated", format:"{0:dd-MM-yyyy}", width:"150px", filterable:false},
                    {field: "TerminationStatus", editor:statusEditor,title:"Termination Status",template:statusTemplate, filterable:false},
                    {field: "Remarks", filterable:false},
                    {command:["destroy"], width:"100px"},
                ],
                toolbar:[{template:"<button class='k-button' onclick='javascript:terminate()'><span class='k-icon k-i-cancel'></span>Submit</button>"}]
            });
        }

        var firstTime = true;

        $("#search-button").click(function() {
            jsonPost("#main-content", "@Url.Action("SearchAgent")", viewModel.AgencySearch, function(response) {
               //response.Data.ScheduledOn = new Date(parseInt(response.Data.ScheduledOn.substr(6)))
               if(checkExists(response.Data) == false) {
                   response.Data.ScheduledOn = "";
                    viewModel.TerminationAgents.push(response.Data);
                    if(firstTime) {
                        bindGrid();
                        firstTime = false;
                    }
                }
            });
        });

        if(viewModel.TerminationAgents!=null)
        {
            if(viewModel.TerminationAgents.length>0)
            {
                bindGrid();
               firstTime=false;
           }
        }

    });

    function terminate() {
        if(validate() == false) return;
         jsonPost("#main-content", "@Url.Action("Process")", viewModel, function(response) {
             addBreadCrumb("Complete", "#", 2);
             $('#main-content').hide();
             $('#complete-content').show();
         });

    }

    function validate() {
        hideSummary("#main-content");
         var today = new Date();
         today = new Date(today.getFullYear(), today.getMonth(), today.getDate());
        for(var i = 0; i < viewModel.TerminationAgents.length; i++) {
            var agencyNumber = viewModel.TerminationAgents[i].AgencyNumber;
            if (agencyNumber.indexOf('not') > 0){
                addErrorToSummary("#main-content", agencyNumber);
                return false;
            }
            var selectedStatus = viewModel.TerminationAgents[i].TerminationStatus;
            if(!selectedStatus) selectedStatus = terminationActions[0];
            viewModel.TerminationAgents[i].ActionID= selectedStatus.ID;
            var scheduledOn = viewModel.TerminationAgents[i].ScheduledOn;
            var status= selectedStatus.Code;
            var remarks=viewModel.TerminationAgents[i].Remarks;
            if((scheduledOn == "" || scheduledOn == null) && status!="NR") {
                addErrorToSummary("#main-content", "Please enter termination date for agent " + agencyNumber);
                return false;
           }

           if(scheduledOn> today) {
                addErrorToSummary("#main-content", "Termination date cannot be greater than current date for agent "+ agencyNumber);
                return false;
           }
            if ((status == "NR" || status == "TER") && (remarks == "" || remarks == null)) {
                addErrorToSummary("#main-content", "Please enter remarks");
                return false;
            }
            if (remarks != "" && remarks != null) {
                if (remarks.length >= 50) {
                    addErrorToSummary("#main-content", "Remarks must be less than 50 characters'");
                    return false;
                }
            }
        }
        return true;
    }

    function checkExists(agent) {
        hideSummary("#main-content");
        for(var i = 0; i < viewModel.TerminationAgents.length; i++) {
            if(viewModel.TerminationAgents[i].AgencyNumber == agent.AgencyNumber) {
                addErrorToSummary("#main-content", "Agent is already exist in the grid");
                return true;
            }
        }
        return false;
    }
    function statusEditor(container, options) {
        $('<input data-text-field="Description" data-value-field="ID" data-bind="value:' + options.field + '"/>')
                        .appendTo(container)
                        .kendoDropDownList({
                            autoBind: true,
                            dataTextField:"Description",
                            dataValueField:"ID",
                            dataSource: {
                                data: terminationActions
                            }
                        });
    }
    function statusTemplate(container,options){
        if(container.TerminationStatus)
        return container.TerminationStatus.Description;

        return container.defaults.TerminationStatus.Description;

    }


</script>