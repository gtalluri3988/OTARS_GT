<script type="text/javascript">
    var modelItem = @Html.Raw(@Json.Encode(Model));

    var master;
    $(function () {
        addBreadCrumb("Tbe Exemption", "@Url.Action("TbeExemption")", 1);
        var tbeExmeptionModel = {
            id: "ID"
        };

        $("#tbe-exemption-grid").kendoGrid({
            dataSource: getMasterGridDataSource(masterDataServiceUrl + "/TbeExemptions", tbeExmeptionModel ),
            pageable:true,
            sortable:true,
            filterable:true,
            selectable:true,
            editable:"inline",
            columns: [
                { field: "Name" },
                { field: "ICNumber" },
                { field: "OldICNumber" },
                { field: "DateDocumentReceived", template: "#= kendo.toString(kendo.parseDate(DateDocumentReceived, 'yyyy-MM-dd HH:mm:ss'), 'dd/MM/yyyy') #" },
                { field: "IsActive"},
                { field: "ID", template:"<button class='k-button' onclick='onEditClick()'><span class='k-icon k-i-pencil'></span>Edit</button>", filterable:false, title:" "},
                { command: ["destroy"]}
            ],
            toolbar:[{template:"<button class='k-button' onclick='javascript:onAddClick()'><span class='k-icon k-i-plus'></span>Add</button>"}]
        });

        master = new Master({
            url: masterDataServiceUrl + "/TbeExemptions",
            gridSelector: "#tbe-exemption-grid", detailsSelector: "#tbe-exemption-details", modelItem: modelItem,
            validationUrl: "@Url.Action("ValidateTbeExemption")"
        });
    });

    function onEditClick() {
        master.editClick();
    }

    function onAddClick() {
        master.addClick();
    }
</script>