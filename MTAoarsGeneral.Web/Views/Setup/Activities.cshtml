@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Masters.ActivityViewModel
@section CssScript{
    @Html.Script("~/Scripts/Master.js")
}           
<div id="activities-content">
    <div id="activities-grid"></div>
    <br />
    <div id="activities-details" style="display:none;text-align:center">
        <table class="mta-panel" style="width:90%">
            <caption>Activities</caption>

            <tr>
                <th>Code</th>
                <td>@Html.BindTextBoxFor(model => model.Code)</td>
                 <th>Description</th>
                <td>@Html.BindTextBoxFor(model => model.Description)</td>
                </tr>
                <tr>
                 <th>MTA Charges</th>
                <td>@Html.BindTextBoxFor(model => model.MTACharge)</td>
                 <th>ISM Charges</th>
                <td>@Html.BindTextBoxFor(model => model.ISMCharge)</td>
                </tr>
                <tr>
                <th>@Html.LabelFor(model => model.IsAdminActivity)</th>
                <td>@Html.BindEditorFor(model => model.IsAdminActivity)</td>
  
            </tr>
             <tr>
                <th colspan="4" style="text-align:right">
                    <button class="k-button" id="save-button"><span class="k-icon k-i-tick"></span>Save</button>
                    <button class="k-button" id="cancel-button"><span class="k-icon k-i-cancel"></span>Cancel</button>
                </th>
            </tr>
        </table>
    </div>
</div>

<script type="text/javascript">
    var modelItem = @Html.Raw(@Json.Encode(Model));
    
    var master;
     $(function () {

             var activityModel = {
            id: "ID"
            
        };


            $("#activities-grid").kendoGrid({
                    dataSource: getMasterGridDataSource(masterDataServiceUrl + "/Activities", activityModel ),
                    pageable:true,
                    sortable:true,
                    filterable:true,
                    selectable:true,
                    editable:"inline",
                    columns: [
                        { field: "Code" },
                        { field: "Description" },
                        { field: "MTACharge" },
                        { field: "ISMCharge" },
                        { field: "IsAdminActivity"},
                        { field: "ID", template:"<button class='k-button' onclick='onEditClick()'><span class='k-icon k-i-pencil'></span>Edit</button>", filterable:false, title:" "},
                        //{ command: ["destroy"]}
                    ],
                    toolbar:[{template:"<button class='k-button' onclick='javascript:onAddClick()'><span class='k-icon k-i-plus'></span>Add</button>"}]
                });

        master = new Master({
            url: masterDataServiceUrl + "/Activities",
            gridSelector: "#activities-grid", detailsSelector: "#activities-details", modelItem: modelItem,
            validationUrl: "@Url.Action("ValidateActivity")"
        });

    });

    function onEditClick() {
        master.editClick();
    }
    
    function onAddClick() {
        master.addClick();
    }
</script>