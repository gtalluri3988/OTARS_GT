@using MTAoarsGeneral.Utilities.Mvc
@model MTAoarsGeneral.ViewModels.Masters.CompanyViewModel
@section CssScript{
    @Html.Script("~/Scripts/Master.js")
}           
<div id="companies-content">
    <div id="companies-grid"></div>
    <br />
    <div id="companies-details" style="display:none;text-align:center">
        <table class="mta-panel" style="width:90%">
            <caption>Activities</caption>

            <tr>
                <th>Code</th>
                <td>@Html.BindTextBoxFor(model => model.Code)</td>
                <th>Name</th>
                <td>@Html.BindTextBoxFor(model => model.Name)</td>
            </tr>
            <tr>
                <th>Abbreviation</th>
                <td>@Html.BindTextBoxFor(model => model.Abbreviation)</td>

                <th>Business Registration Number</th>
                <td>@Html.BindTextBoxFor(model => model.BusinessRegistrationNumber)</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.IsGeneral)</th>
                <td colspan="3">@Html.BindEditorFor(model => model.IsGeneral)</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.IsActive)</th>
                <td>@Html.BindEditorFor(model => model.IsActive)</td>
                <th>@Html.LabelFor(model => model.IsDropDown)</th>
                <td>@Html.BindEditorFor(model => model.IsDropDown)</td>
            </tr>
            <tr>

            </tr>
            <tr>
                <th colspan="4" style="text-align:right">
                    <button class="k-button" id="save-button"><span class="k-icon k-i-tick"></span>Save</button>
                    <button class="k-button" id="cancel-button"><span class="k-icon k-i-cancel"></span>Cancel</button>
                </th>
            </tr>
        </table>
    </div>
</div>

<script type="text/javascript">
    var modelItem = @Html.Raw(@Json.Encode(Model));
    
    var master;
    $(function () {

        var companyModel = {
            id: "ID",
            fields: {
                IsGeneral: { type: "boolean" },
                IsActive: { type: "boolean" },
                IsDropDown: { type: "boolean" }
            }
            
        };

        $("#companies-grid").kendoGrid({
            dataSource: getMasterGridDataSource(masterDataServiceUrl + "/Companies", companyModel ),
            pageable:true,
            sortable:true,
            filterable:true,
            selectable:true,
            editable:"inline",
            columns: [
                { field: "Code" },
                { field: "Name" },
                { field: "BusinessRegistrationNumber" },
                { field: "Abbreviation" },
                { field: "IsGeneral", title: "Is General" },
                { field: "IsActive", title: "Is Active" },
                { field: "IsDropDown", title: "Is Dropdown" },
                { field: "ID", template:"<button class='k-button' onclick='onEditClick()'><span class='k-icon k-i-pencil'></span>Edit</button>", filterable:false, title:" "},
                //{ command: ["destroy"]}
            ],
            toolbar:[{ template: "<button class='k-button' onclick='javascript:onAddClick()'><span class='k-icon k-i-plus'></span>Add</button>" }]
        });

        master = new Master({
            url: masterDataServiceUrl + "/Companies",
            gridSelector: "#companies-grid",
            detailsSelector: "#companies-details",
            modelItem: modelItem,
            validationUrl: "@Url.Action("ValidateCompany")"
        });

    });

    function onEditClick() {
        master.editClick();
    }
    
    function onAddClick() {
        master.addClick();
    }
</script>