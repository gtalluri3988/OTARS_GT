@using MTAoarsGeneral.Utilities.Mvc
<!DOCTYPE html>
<html>
<head id="page-head">
    <title>MTAoars General</title>

    @Html.StyleSheet("~/Content/Css/kendo.common.min.css")
    @Html.StyleSheet("~/Content/Css/kendo.uniform.min.css")
    @Html.StyleSheet("~/Content/Css/Site.css")

    @Html.Script("~/Scripts/jquery-3.6.0.min.js")
    @Html.Script("~/Scripts/jquery-migrate-3.0.0.js")
    @Html.Script("~/Scripts/kendo.web.min.js")

    @Html.Script("~/Scripts/site.js")
    <script type="text/javascript">
        var printUrl = "@Url.Action("Print", "Home")";
        var unauthorizedUrl = "@Url.Action("Unauthorized", "Account")";
        var masterDataServiceUrl = "@Url.Content("~/MasterDataService.svc")";
        $(function () {
            $("#page-menu").kendoMenu();
        });
    </script>

    @RenderSection("CssScript", false)
</head>
<body>
    <div id="page-wrapper" style="width: 100%; height: 100%">
        <div id="page-header-warapper" style="background-color:#0F1923;height:10%">
            <div style="height:80%">
                <div style="float: left; width: 350px;color:#FFFFFF;font-weight:bold;font-size:17px">
                    Malaysian Takaful Association
                </div>
                <div style="margin-left: 110px">
                    <div style="height: 60%; text-align: right;margin-right:20px;color:White">
                        @if (Html.GetIdentity() != null)
                        {
                            <table style="float:right">
                                <tr>
                                    <td>
                                        Welcome @Html.GetIdentity().Name <br />
                                        @Html.GetIdentity().CompanyName
                                    </td>
                                    <td>
                                        <a href='@Url.Action("LogOut", "Account")'>
                                            <img src="@Url.Content("~/Content/Images/logout-icon.png")" alt="logout" style="width:32px;height:32px;border:0px" />
                                        </a>
                                    </td>
                                </tr>
                            </table>

                        }
                    </div>
                </div>
            </div>
            <div style="width: 100%;height:20%">
                @{
                    var identity = Html.GetIdentity();
                }

                <ul id="page-menu">
                    @foreach (var menu in identity.Menus)
                    {
                        <li>
                            @menu.Description
                            <ul>
                                @foreach (var subMenu in menu.Menus)
                                {
                                    if (string.IsNullOrEmpty(subMenu.Url))
                                    {
                                        <li>
                                            @subMenu.Description
                                            <ul>
                                                @foreach (var subsubMenu in subMenu.Menus)
                                                {
                                                    <li><a href="@Url.Content(subsubMenu.Url)">@subsubMenu.Description</a></li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                    else
                                    {
                                        <li><a href="@Url.Content(subMenu.Url)">@subMenu.Description</a></li>
                                    }
                                }
                            </ul>
                        </li>
                    }

                </ul>
            </div>
        </div>

        <div id="content-wrapper" style="clear:both;height:82.6%">
            <div style="margin-top:30px;margin-left:10px;min-height:100%">
                <div id="page-title" style="font-size:14;font-weight:bold;color:#0F1923;padding-bottom:5px">
                    @RenderSection("PageTitle", false)
                </div>

                <div id="page-bread-crumbs">
                    <ul class="breadcrumb">
                        <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                    </ul>
                </div><br />
                <ul class="k-widget k-tooltip k-tooltip-validation mta-error-summary">
                    <li>This is first error</li>
                    <li>This is second error</li>
                </ul>
                @RenderBody()
            </div>

            <div id="footer" style="height:3%;text-align:center;background-color:#0F1923;color:White">
                Powered by <a href="http://www.torrenttech.com.my" title="Powered by Torrent" class="k-link">Torrent Technologies</a>
            </div>
        </div>


    </div>

</body>

<div id="info-window"></div>
</html>
