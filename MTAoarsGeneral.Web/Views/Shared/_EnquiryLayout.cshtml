    <style type="text/css">
        .navbar-dark {
            background: #0d437f;
        }

            .navbar-dark .navbar-nav .nav-link {
                color: #fff;
            }

        .mta-panel th {
            border: 0px;
            background-color: #e1e1e1 !important;
        }

        .footerWrap {
            width: 100%;
        }

        .footerlink {
            width: 960px;
            margin: 0 auto;
            background: #fff;
            border-left: 1px solid #e1e1e1;
            border-right: 1px solid #e1e1e1;
        }

        .footerSection {
            width: 100%;
            clear: both;
            font-size: 0.8em;
        }

        address {
            padding: 0px 5px 0px 10px;
        }

            address div {
                float: left;
                margin-right: 5px;
            }

            address ul {
                margin: 5px 0 0;
                padding: 0;
                float: left;
            }

                address ul li {
                    list-style: none;
                    border-left: 1px solid #d9d9d9;
                    float: left;
                }

                    address ul li:first-child {
                        border-left: none;
                    }

                    address ul li a {
                        display: block;
                        color: #5a5a5a;
                        padding: 0 5px;
                    }

            address p {
                float: right;
            }

        footer {
            position: relative;
            right: 0;
            bottom: 0;
            left: 0;
            text-align: center;
        }

        @@media screen and (min-width: 1250px) {
            footer {
                position: absolute;
            }
        }
    </style>

    @RenderSection("CssScript", false)

</head>
